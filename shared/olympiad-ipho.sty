% ============================================================
% TYPOGRAPHY
% ============================================================

\setlength{\parindent}{0pt}
\setlength{\intextsep}{0pt}      % no extra space around floats

% \setcounter{page}{1} inside \problem/\solution below (every ipho
% problem restarts its own page count for the T<n>-<page> cipher) used
% to trigger xdvipdfmx's "Object @page.N already defined" the moment a
% SECOND problem repeated a page number -- fixed once, for every style,
% via plainpages=false on hyperref itself (see olympiad-layout.sty's
% own comment on that option for why \hypersetup{pageanchor=false} is
% the wrong fix: it silences the warning by deleting the destinations
% \pageref points at, rather than making them unique).

% ============================================================
% LIST CONFIGURATION
% ============================================================

\setlist[itemize]{topsep=0pt, noitemsep}
\setlist[enumerate]{topsep=0pt, leftmargin=38pt, noitemsep}
\setlist[enumerate,1]{label=\arabic*)}

% ============================================================
% task ENVIRONMENT
% ============================================================
\ExplSyntaxOn
\bool_new:N \l__olymp_task_first_item_bool
\tl_new:N \l__olymp_task_points_tl

% We redeclare the keys to just "sink" (ignore) the values. 
% This ensures [type=subproblem] doesn't throw an "unrecognised key" 
% error, but naturally falls back to the framed style.
\DeclareKeys[olymp/task]
  {
    type .code:n = {} ,
  }

% \New (not \Renew): olympiad.cls no longer defines `task` itself (it
% moved out to each style's own .sty, see olympiad.cls's "What this
% file provides" note) and olympiad-respa.sty is mutually exclusive
% with this file (only one style's .sty ever loads per compile), so
% there's nothing to renew here -- task doesn't exist yet at this
% point when style=ipho is active.
\NewDocumentEnvironment{task}{ O{} }
  {
    % Process the options (which are ignored per the declaration above)
    \SetKeys[olymp/task]{#1}
    
    \bool_set_true:N \l__olymp_task_first_item_bool
    
    % Save the standard \item and current list depth. 
    % This prevents standard inner lists (like itemize) from breaking.
    \let\olymp@orig@item\item
    \edef\olymp@task@listdepth{\the\@listdepth}
    
    \RenewDocumentCommand{\item}{ o }
      {
        % Check if we are inside a nested list environment
        \ifnum\@listdepth>\olymp@task@listdepth\relax
          \IfValueTF{##1}{ \olymp@orig@item[##1] }{ \olymp@orig@item }
        \else
          % --- TOP-LEVEL TASK ITEM ---
          \bool_if:NTF \l__olymp_task_first_item_bool
            {
              % First item: just switch the flag
              \bool_set_false:N \l__olymp_task_first_item_bool
            }
            {
              % Subsequent items: Close the PREVIOUS minipage and framed block
              \end{minipage}
              \parbox{.1\textwidth}{
                \hspace{1em}
                \tl_if_empty:NF \l__olymp_task_points_tl
                  { \l__olymp_task_points_tl \nobreakspace pt }
              }
              \end{framed}
            }
          
          % Process the NEW item's points from the optional argument
          \IfValueTF{##1}
            { \tl_set:Nn \l__olymp_task_points_tl {##1} }
            { \tl_clear:N \l__olymp_task_points_tl }
            
          \refstepcounter{tasknum}
          
          % Open the NEW item's framed block and minipages
          \begin{framed}
            \noindent
            \parbox[t]{.1\textwidth}{
              \hspace{1em}
              % Note: Adjust \arabic{subproblemnum} to \printcounter{subproblemnum} 
              % if you rely on a custom counter macro from your class.
              \noindent\textbf{\printcounter{subproblemnum}.\arabic{tasknum}}
            }
            \begin{minipage}[t]{.79\textwidth}
        \fi
      }
  }
  {
    % End of environment: Close the very last item's blocks if items existed
    \bool_if:NF \l__olymp_task_first_item_bool
      {
        \end{minipage}
        \parbox{.1\textwidth}{
          \hspace{1em}
          \tl_if_empty:NF \l__olymp_task_points_tl
            { \l__olymp_task_points_tl \nobreakspace pt }
        }
        \end{framed}
      }
  }
\ExplSyntaxOff

