\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{olympiad-ipho}[2027/01/01 IPhO-style olympiad-layout extension]

\OlympLayoutMatchedtrue


% ============================================================
% FONTS --- 9pt as defined by .cls
% ============================================================
\definecolor{ipho-def}{rgb}{0,0,.7}

% Vendored at shared/fonts/ (NotoSans-{Regular,Bold,Italic,BoldItalic}.ttf),
% found via the TTFONTS kpathsea search path the project's root
% .latexmkrc sets (mirrors how TEXINPUTS resolves \input{competitions/...}
% regardless of compile-directory depth) -- no Path= key here, same
% reasoning as respa's CMU Serif block in olympiad-respa.sty. Ligatures=TeX
% for the same reason respa needs it: this corpus's problem/solution prose
% relies on classic TeX ligatures (---, ``/'') throughout.
\setmainfont{NotoSans-Regular}[
  Extension = .ttf,
  BoldFont = NotoSans-Bold,
  ItalicFont = NotoSans-Italic,
  BoldItalicFont = NotoSans-BoldItalic,
  Ligatures = TeX,
]
\setsansfont{NotoSans-Regular}[
  Extension = .ttf,
  BoldFont = NotoSans-Bold,
  ItalicFont = NotoSans-Italic,
  BoldItalicFont = NotoSans-BoldItalic,
  Ligatures = TeX,
]
% No \setmonofont -- no monospace Noto file is vendored; fontspec falls
% back to its own default (Latin Modern Mono) until one is added here.

