}

% ============================================================
% \tasksol, \taskref, \solref
% ============================================================
% TODO: repurpose for ipho; currently copied from respa
\newcommand{\tasksol}{%
  \vspace{6pt}%
  \hspace*{18pt}%
  \stepcounter{tasksolnum}%
  \textbf{\printcounter{subsolnum}.\thetasksolnum}~%
}

\newcommand{\taskref}[1]{\textbf{\printcounter{subproblemnum}.#1}}
\newcommand{\solref}[1]{\textbf{\printcounter{subsolnum}.#1}}

% ============================================================
% PROBLEM AND SOLUTION HEADING TYPOGRAPHY
% ============================================================

\newcommand{\OlympProblemHeading}[1]{%
  {\noindent\fontsize{16pt}{14pt}\fontshape{bf}\selectfont\textcolor{ipho-def}{\textbf{#1}}}
}
\newcommand{\OlympSolutionHeading}[1]{%
  {\noindent\fontsize{16pt}{14pt}\fontshape{bf}\selectfont\textcolor{ipho-def}{\textbf{#1}}}
}
% \renewcommand (not \newcommand): \part is article.cls's own
% sectioning command, already defined before this file loads --
% \newcommand on an existing name is a hard "already defined" error.
% Also takes 2 args (#1=font size in pt, #2=title), unlike respa's
% \part (1 arg, no size control) -- both are valid per-style designs
% since nothing outside each style's own .sty calls \part today, but
% flagging the mismatch in case that wasn't intentional.
\renewcommand{\part}[1]{%
    \vspace{6pt}\noindent%
    { \hspace*{-3pt}\textbf{#1}}\nopagebreak%
}

% ============================================================
% \problem                \solution
% \subproblem             \subsolution
% ============================================================

\newcommand{\problem}[2]{%
  % #1 = title, #2 = points string
  \stepcounter{problemnum}%
  \setcounter{tasknum}{0}%
  \setcounter{figcounter}{0}%
  \setcounter{page}{1}
  \par%
  \OlympProblemHeading{%
    #1~(#2 \OlympString{points_long})%
  }%
  \vspace{6pt}
}


\newcommand{\solution}[2]{%
  % #1 = title, #2 = points string
  \stepcounter{solnum}%
  \setcounter{tasknum}{0}%
  \setcounter{tasksolnum}{0}%
  \setcounter{equation}{0}%
  \stepcounter{blocknum}%
  \setcounter{page}{1}
  \par%
  \OlympSolutionHeading{%
    #1~(#2 \OlympString{points_long})%
  }\par%
  \vspace{6pt}
}

\newcommand{\subproblem}[2]{%
  % #1 = label (e.g. А), #2 = points string
  \setcounter{tasknum}{0}%
  \stepcounter{subproblemnum}%
  \vspace{6pt}\par\noindent%
    { \hspace*{-3pt}\fontsize{10pt}{10pt}%
    \selectfont\textcolor{ipho-def}%
    {%
      \textbf{\OlympString{part}~\printcounter{subproblemnum} --- #1 (#2 \OlympString{points_short})}%
    }%
    }\nopagebreak%
  \vspace{6pt}
}

\newcommand{\subsolution}[2]{%
  % #1 = label (e.g. А), #2 = points string
  \stepcounter{subsolnum}%
  \setcounter{tasknum}{0}%
  \setcounter{tasksolnum}{0}%
  \par%
  \vspace{6pt}\noindent%
    { \hspace*{-3pt}\fontsize{11pt}{11pt}%
    \selectfont\textcolor{ipho-def}%
    {%
      \textbf{\OlympString{part}~\printcounter{subsolnum} --- #1 (#2 \OlympString{points_short})}%
    }%
    }\nopagebreak%
  \vspace{6pt}
}

