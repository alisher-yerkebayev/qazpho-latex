\RequirePackage{fancyhdr}

% TODO: adapt from ipho2016.cls (currently, it's copied from respa)
% Shared right header (Page n/N)
\makeatletter
% Define the helper macros outside so they tokenize '@' properly
\newcommand{\letter@header}%
{%
  \ifOlympMarking M \else%
    \ifOlympExperiment E\else T\fi
  \fi
}

\newcommand{\num@header}{%
  \ifOlympSolutions%
    \arabic{solnum}%
  \else%
    \ifOlympMarking%
      \arabic{solnum}%
    \else%
      \arabic{problemnum}%
    \fi%
  \fi%
}

% Define your main styling command
\newcommand{\OlympCommonRightHead}{%
  \renewcommand{\headrulewidth}{2pt}%
  \fancyhead[R]{\textbf{\fontsize{2cm}{2.5cm}\selectfont \letter@header\num@header-\thepage}\\\rm \OlympString{name}~\OlympYear}%
}
\makeatother

% not used in style=ipho
\newlength{\problemsheaderExtra}
\setlength{\problemsheaderExtra}{6mm}

% 1. "problems" Style
\fancypagestyle{problems}{%
  \fancyhf{}% Clear all headers and footers
  \OlympCommonRightHead%
  \fancyhead[L]{%
    \textbf{\\\vfill \fontsize{.5cm}{.5cm} \selectfont%
    \ifOlympTheory\OlympString{theory}\fi%
    \ifOlympExperiment\OlympString{experiment}\fi%
    } \\ \includegraphics[height=2cm]{\OlympString{logo}} % must be defined in strings-config.tex
  }%
}

% 2. "solutions" Style
\fancypagestyle{solutions}{%
  \fancyhf{}% Clear all headers and footers
  \OlympCommonRightHead%
  \fancyhead[L]{%
    \textbf{\\\vfill \fontsize{.5cm}{.5cm} \selectfont%
    \ifOlympTheory\OlympString{theory}\fi%
    \ifOlympExperiment\OlympString{experiment}\fi%
    /\OlympString{solutions}
    } \\ \includegraphics[height=2cm]{\OlympString{logo}} % must be defined in strings-config.tex
  }%
}

% 3. "marking" Style
\fancypagestyle{marking}{%
  \fancyhf{}% Clear all headers and footers
  \OlympCommonRightHead%
  \fancyhead[L]{%
    \textbf{\\\vfill \fontsize{.5cm}{.5cm} \selectfont%
    \ifOlympTheory\OlympString{theory}\fi%
    \ifOlympExperiment\OlympString{experiment}\fi%
    /\OlympString{marking_schemes}
    } \\ \includegraphics[height=2cm]{\OlympString{logo}} % must be defined in strings-config.tex
  }%
}

% 4. "answersheets" Style --- not used in style=ipho
\fancypagestyle{answersheets}{%
  \fancyhf{}% Clear all headers and footers
  \OlympCommonRightHead%
  \fancyhead[L]{%
    \textbf{\\\vfill \fontsize{.5cm}{.5cm} \selectfont%
    \ifOlympTheory\OlympString{theory}\fi%
    \ifOlympExperiment\OlympString{experiment}\fi%
    /\OlympString{answersheets}
    } \\ \includegraphics[height=2cm]{\OlympString{logo}} % must be defined in strings-config.tex
  }%
}

% only valid for style=respa; left here for backwards-compatibility
% (though it's not supposed to be called outside style=ipho)
\fancypagestyle{firstpage}{%
  \fancyhf{}%
  \addtolength{\headsep}{-\problemsheaderExtra}%
  \fancyhead[C]{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[L]{%
    \textbf{%
      \OlympString{duration}%
    }%
  }%
}

% ==========================================
% Initial State Activation
% ==========================================
\ifOlympJury
  \pagestyle{empty}
\else
  \ifOlympSolutions
    \pagestyle{solutions}
  \else
    \ifOlympMarking
      \pagestyle{marking}
    \else
      \pagestyle{problems}
    \fi
  \fi
\fi

