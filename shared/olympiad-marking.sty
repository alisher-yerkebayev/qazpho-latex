\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{olympiad-marking}[2027/01/01 v1.2 Author-facing rough marking-scheme preview]

% ============================================================
%  olympiad-marking.sty
%  Author-facing "rough marking scheme" preview layer. Loaded only
%  by preamble_author.tex, never by build.py output.
%
%  Requires: olympiad.cls (loaded first) -- uses \OlympCurrentPrefix,
%  \OlympStringFallback, and the fact that \solution/\subsolution
%  already reset the `equation' counter.
%
%  ============================================================
%  WHY EVERYTHING BELOW IS BUILT THE WAY IT IS -- READ THIS FIRST
%  ============================================================
%  Two independent, hard-won facts drive almost every design choice
%  in this file:
%
%  (1) \OlympStringFallback (\@ifundefined-based) and hyperref's
%      real \eqref/\ref machinery are BOTH genuinely unsafe to force
%      through a SECOND expansion pass (an expl3 ":x"/"Nx" argument,
%      i.e. an \edef-like context). Their internal \reserved@a/
%      \reserved@b-style bookkeeping assumes it is running in normal
%      execution, not being re-scanned by another \edef. Doing so
%      doesn't just give a wrong answer -- it throws a raw,
%      confusing TeX error ("Undefined control sequence
%      \reserved@a", "Argument of \reserved@a has an extra }") that
%      has nothing to do with the actual mistake.
%
%      Consequence: whenever this file needs to freeze author
%      content (an eq's body/suffix, a \criterion's {text}) into a
%      permanent row -- because \l__olympm_*_tl are shared locals
%      that the NEXT \eq/\criterion call will overwrite -- it must
%      freeze it WITHOUT expanding it. The tool for that is
%      \tl_gset_eq:cN (a \let-style copy: zero expansion, but still
%      captures the CURRENT content into an INDEPENDENT variable,
%      immune to the shared local being reset later). Every
%      "*_tl" -> "row satellite" step below exists for this reason.
%
%  (2) \OlympCurrentPrefix (like the old \__olympm_eq_prefix:) is
%      built from \arabic/\printcounter/\ifOlympProblems/etc. --
%      ALL genuinely safe to expand -- but it reads LIVE, MUTABLE
%      counters (solnum, subsolnum, ...). That makes it fundamentally
%      different from \OlympStringFallback: it is *safe* to
%      freeze via a normal ":x" pass, but *unsafe to leave lazy*,
%      because by the time a deferred \showmarking finally executes
%      a left-lazy reference, those counters may have moved on to a
%      LATER problem, silently producing the WRONG target.
%
%      Consequence: this file always freezes \OlympCurrentPrefix
%      (and \theequation) into plain digits/letters via a small,
%      isolated ":x" step AT RECORD TIME, for anything it builds
%      itself (like the clickable "(n)" in a marking row). It
%      CANNOT do the same for an \eqref{n} an AUTHOR embeds inside
%      `suffix'/`tail'/\criterion's {text}, because \eqref calls the
%      genuinely-unsafe-to-refreeze \OlympOldEqref -- so that one
%      piece of author content is kept completely unexpanded/lazy
%      (fact (1)'s remedy), which means it resolves using whatever
%      \OlympCurrentPrefix is active WHEN \showmarking FINALLY
%      TYPESETS THE ROW, not when the \eq/\criterion was written.
%
%      THIS IS WHY \showmarking MUST BE CALLED BEFORE THE NEXT
%      \solution/\subsolution/\subproblem, i.e. right after each
%      block's criteria (the unstarred, buffer-flushing form is the
%      default for exactly this reason). Deferring it to the very
%      end and letting \eq/\criterion calls from several different
%      problems pile up in one buffer WILL make any author \eqref{n}
%      embedded in that content resolve against the WRONG (final)
%      problem's prefix. This is not a bug to "fix" harder -- it is
%      the unavoidable cost of \eqref's target depending on live
%      counters, and the one-flush-per-block pattern sidesteps it
%      completely. If you truly need one combined table at the end,
%      don't use \eqref inside suffix/tail/\criterion text; refer to
%      equations by writing the number in plain words instead.
%
%  New language-neutral string slots (via \OlympStringFallback):
%    eq_formula, eq_numerical, marking_content, marking_points, marking_total
% ============================================================

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{tabularx}   % no-op if olympiad-layout.sty already loaded it

\newcommand{\juryheader}{%
\newpage
\ifOlympTheory%
\stepcounter{solnum}%
\hspace{12pt}\textbf{\OlympGrade{} \OlympString{grade_text}. \OlympString{problem}~\thesolnum. \OlympString{marking_jury}: \underline{\hspace{4.5cm}}. \OlympString{marking_cipher}: \underline{\hspace{4.5cm}}}%
\fi\ifOlympExperiment%
\hspace{12pt}\textbf{\OlympGrade{} \OlympString{grade_text}. Эксперимент. \OlympString{marking_jury}: \underline{\hspace{4.5cm}}. \OlympString{marking_cipher}: \underline{\hspace{4.5cm}}}%
\fi%
}

% ---- ltablex/tabularx compatibility shim -------------------------
%
% olympiad-layout.sty loads ltablex (so long marking tables can break
% across a page, via longtable under the hood). ltablex works by
% completely REPLACING tabularx's own \TX@endtabularx -- and its
% replacement's last line is a hardcoded, literal `\end{tabularx}'
% (see ltablex.sty), discarding vanilla tabularx's own closing step,
% which instead re-emits `\end{<name>}' for whatever \@currenvir
% actually was when `\tabularx{width}{cols}' was first called.
%
% That \@currenvir trick is exactly what lets the OLD-STYLE
% `\tabularx{width}{cols} ... \endtabularx' call (no \begin/\end) be
% wrapped inside a custom \newenvironment and closed via THAT
% environment's own \end{<name>} -- which is exactly how `mse' below
% is built, so that content authors can add rows via \escheme/
% \bscheme/\blockbegin/\etotal between \begin{mse} and \end{mse}
% (the modern `\begin{tabularx}...\end{tabularx}' form CANNOT be
% wrapped this way at all: LaTeX sets \@currenvir to "tabularx"
% itself the moment \begin{tabularx} runs, so tabularx's own body-
% capture then goes looking for a literal `\end{tabularx}' that
% never appears in the source -- it's hidden inside \end{mse} -- and
% runs off the end of the file. The raw, no-\begin/\end call is the
% only form that can be wrapped in a custom environment at all.).
%
% With ltablex's hardcoded `\end{tabularx}' in place, `mse' fails
% every time with "\begin{mse} ... ended by \end{tabularx}", because
% the kernel's environment stack still has "mse" on top, not
% "tabularx", when that literal \end{tabularx} finally runs.
%
% Fix: reinstate ltablex's ENTIRE \TX@endtabularx (so its longtable-
% based page-breaking is untouched) but swap its last line back to
% the \@currenvir-aware close. For an ordinary, un-wrapped
% `\begin{tabularx}...\end{tabularx}' elsewhere in the document this
% is a no-op -- \@currenvir there really is "tabularx", so the
% reconstructed `\end{\TX@}' IS `\end{tabularx}', identical to
% ltablex's own hardcoded version. Only the wrapped-in-another-
% environment case (mse) actually changes behavior -- for the
% better. Guarded by \@ifpackageloaded so this is a pure no-op
% (vanilla tabularx's \TX@endtabularx is already \@currenvir-aware)
% if olympiad-marking.sty is ever used without olympiad-layout.sty.
%
% NB: no \makeatletter/\makeatother pair here -- catcode(@)=11 is
% already in effect for this whole file (the kernel wraps every
% \RequirePackage/\usepackage'd file in that automatically). A
% \makeatother would unconditionally force catcode(@) back to 12 for
% everything AFTER it in this file -- not "restore" anything, since
% \makeatother doesn't remember a prior state -- silently breaking
% every other @-name below (e.g. \eqref's own \@ifundefined a few
% hundred lines down, PART 10), which would then print as literal,
% garbled running text instead of executing.
\@ifpackageloaded{ltablex}{
  \renewcommand\TX@endtabularx{%
    \expandafter\TX@newcol\expandafter{\tabularxcolumn{\TX@col@width}}%
    \let\verb\TX@verb
    \def\@elt##1{\global\value{##1}\the\value{##1}\relax}%
    \edef\TX@ckpt{\cl@@ckpt}%
    \let\@elt\relax
    \TX@old@table=\maxdimen
    \TX@col@width=\TX@target
    \global\TX@cols=\@ne
    \TX@typeout@
      {\@spaces Table Width\@spaces Column Width\@spaces X Columns}%
    \let\savecaption\caption
    \def\caption{\@ifstar\TX@cap@gobble\TX@cap@gobble}%
    \let\saveendhead\endhead
    \def\endhead{\\}%
    \let\saveendfirsthead\endfirsthead
    \def\endfirsthead{\\}%
    \let\saveendfoot\endfoot
    \def\endfoot{\\}%
    \let\saveendlastfoot\endlastfoot
    \def\endlastfoot{\\}%
    \ifTX@convertX@
      \TX@trial{\def\NC@rewrite@X{\NC@find l}}%
      \ifdim\wd\@tempboxa<\TX@target
        \TX@newcol{l}%
      \else
        \TX@convertX@false
      \fi
    \fi
    \ifTX@convertX@
      \relax
    \else
      \TX@trial{\def\NC@rewrite@X{%
          \global\advance\TX@cols\@ne\NC@find p{\TX@col@width}}}%
      \loop
        \TX@arith
        \ifTX@
        \TX@trial{}%
      \repeat
    \fi
    {\let\@footnotetext\TX@ftntext\let\@xfootnotenext\TX@xftntext
      \LTchunksize\maxdimen
      \let\caption\savecaption
      \let\endhead\saveendhead
      \let\endfirsthead\saveendfirsthead
      \let\endfoot\saveendfoot
      \let\endlastfoot\saveendlastfoot
      \expandafter\longtable
        \the\toks@
      \endlongtable
      }%
    \global\TX@ftn\expandafter{\expandafter}\the\TX@ftn
    \ifnum0=`{\fi}%
     \expandafter\expandafter\expandafter
     \TX@find@endtabularxbb
      \expandafter\end\expandafter{\TX@}%
      \endtabularx\TX@\endtabularx\TX@find@endtabularxb
  }
}{}

\ExplSyntaxOn

% ---- PART 1: storage --------------------------------------------
\seq_new:N \g__olympm_rows_seq
\int_new:N \g__olympm_rowid_int
\int_gzero:N \g__olympm_rowid_int
\fp_new:N  \g__olympm_total_fp
\fp_gzero:N \g__olympm_total_fp

% ---- PART 2: per-call local state --------------------------------
\tl_new:N \l__olympm_points_tl
\tl_new:N \l__olympm_numpoints_tl
\tl_new:N \l__olympm_prefix_tl
\tl_new:N \l__olympm_label_tl
\tl_new:N \l__olympm_override_tl
\tl_new:N \l__olympm_suffix_tl
\tl_new:N \l__olympm_type_tl
\tl_new:N \l__olympm_captured_body_tl
\tl_new:N \l__olympm_shown_body_tl
\tl_new:N \l__olympm_n_tl              % frozen \theequation, digits only
\tl_new:N \l__olympm_fullprefix_tl     % frozen \OlympCurrentPrefix, text only
\tl_new:N \l__olympm_reflabel_tl       % frozen label actually used for this eq
\tl_new:N \l__olympm_row_tl            % scratch: row under construction
\bool_new:N \l__olympm_numpoints_present_bool

% ---- PART 3: type normalisation (unchanged semantics) ------------
\cs_new_protected:Npn \__olympm_settype_eq:n #1 {
  \str_case:nnF {#1}
    {
      {common}      { \tl_set:Nn \l__olympm_type_tl {common} }
      {alternative} { \tl_set:Nn \l__olympm_type_tl {alt} }
      {other}       { \tl_set:Nn \l__olympm_type_tl {alt} }
    }
    {
      \PackageWarning{olympiad-marking}
        { type=#1~is~not~meaningful~for~eq~(only~common~/~alternative~/~other~are);~treating~as~common,~exactly~like~extract-solution.py~will }
      \tl_set:Nn \l__olympm_type_tl {common}
    }
}

\cs_new_protected:Npn \__olympm_settype_criterion:n #1 {
  \str_case:nnF {#1}
    {
      {remark}      { \tl_set:Nn \l__olympm_type_tl {alt} }
      {penalty}     { \tl_set:Nn \l__olympm_type_tl {alt} }
      {alternative} { \tl_set:Nn \l__olympm_type_tl {alt} }
    }
    {
      \PackageWarning{olympiad-marking}
        { type=#1~is~not~recognised~by~\string\criterion~(only~remark~/~penalty~/~alternative~are);~treating~as~plain~text,~exactly~like~extract-solution.py~will }
      \tl_set:Nn \l__olympm_type_tl {common}
    }
}

% ---- PART 4: reset helpers ---------------------------------------
\cs_new_protected:Npn \__olympm_eq_reset: {
  \tl_clear:N \l__olympm_points_tl
  \tl_clear:N \l__olympm_numpoints_tl
  \tl_clear:N \l__olympm_prefix_tl
  \tl_clear:N \l__olympm_label_tl
  \tl_clear:N \l__olympm_override_tl
  \tl_clear:N \l__olympm_suffix_tl
  \tl_set:Nn  \l__olympm_type_tl {common}
}

\cs_new_protected:Npn \__olympm_criterion_reset: {
  \tl_clear:N \l__olympm_points_tl
  \tl_set:Nn  \l__olympm_type_tl {common}
}

% ---- PART 5: keys (kernel \DeclareKeys/\SetKeys, matching cls) ---
\DeclareKeys[olympm/eq]
  {
    points     .tl_set:N = \l__olympm_points_tl,
    numpoints  .tl_set:N = \l__olympm_numpoints_tl,
    prefix     .tl_set:N = \l__olympm_prefix_tl,
    label      .tl_set:N = \l__olympm_label_tl,
    override   .tl_set:N = \l__olympm_override_tl,
    suffix     .tl_set:N = \l__olympm_suffix_tl,
    tail       .tl_set:N = \l__olympm_suffix_tl,
    type       .code:n   = { \__olympm_settype_eq:n {#1} },
  }

\DeclareKeys[olympm/criterion]
  {
    points .tl_set:N = \l__olympm_points_tl,
    type   .code:n   = { \__olympm_settype_criterion:n {#1} },
  }

% ---- PART 6: point-total bookkeeping (unchanged semantics) -------
\cs_new_protected:Npn \__olympm_addpoints:n #1 {
  \tl_if_empty:nF {#1}
    {
      \tl_if_in:nnF {#1} {/}
        { \fp_gadd:Nn \g__olympm_total_fp {#1} }
    }
}

\cs_new_protected:Npn \__olympm_check_numpoints: {
  \bool_set_false:N \l__olympm_numpoints_present_bool
  \tl_if_empty:NF \l__olympm_numpoints_tl
    {
      \tl_if_eq:eeF {\l__olympm_numpoints_tl} {0}
        {
          \tl_if_eq:eeF {\l__olympm_numpoints_tl} {0.0}
            { \bool_set_true:N \l__olympm_numpoints_present_bool }
        }
    }
}

% ---- PART 7: row-freezing plumbing -------------------------------
%
% \__olympm_snapshot_piece:nN {role} \l__olympm_xxx_tl
%   Copies the CURRENT content of a shared local into a fresh,
%   permanent, THIS-ROW-ONLY variable via \tl_gset_eq:cN -- a
%   \let-style copy, so whatever is inside (including an author's
%   own \eqref{n}) is preserved completely untouched, never
%   expanded, and immune to the shared local being reset by the
%   next \eq/\criterion call.
%
% \__olympm_put_piece:Nn <target tl> {role}
%   Appends, to <target tl>, a PROTECTED reference to that snapshot
%   (\exp_not:N shields \tl_use:c itself from expansion) built via a
%   single ":x" pass whose ONLY job is to resolve the numeric row id
%   into concrete digits -- 100% safe, since the row id is nothing
%   but a counter value.
%
\cs_new_protected:Npn \__olympm_snapshot_piece:nN #1 #2 {
  \tl_new:c { g__olympm_row_ \int_use:N \g__olympm_rowid_int _#1 _tl }
  \tl_gset_eq:cN { g__olympm_row_ \int_use:N \g__olympm_rowid_int _#1 _tl } #2
}
\cs_new_protected:Npn \__olympm_put_piece:Nn #1 #2 {
  \tl_put_right:Nx #1
    { \exp_not:N \tl_use:c { g__olympm_row_ \int_use:N \g__olympm_rowid_int _#2 _tl } }
}

% Snapshots whatever is CURRENTLY staged in \l__olympm_row_tl as the
% row's own final, permanent content.
\cs_new_protected:Npn \__olympm_snapshot_row: {
  \tl_new:c { g__olympm_row_ \int_use:N \g__olympm_rowid_int _tl }
  \tl_gset_eq:cN { g__olympm_row_ \int_use:N \g__olympm_rowid_int _tl } \l__olympm_row_tl
  \seq_gput_right:Nx \g__olympm_rows_seq { \int_use:N \g__olympm_rowid_int }
}

% A CLICKABLE "(n)" reference for a row WE control (not author text):
% prefix and n are frozen to plain text FIRST (both are safe to
% expand -- see the file-level note), so this single ":x" pass never
% has to expand \OlympOldEqref itself, only shield it.
\cs_new_protected:Npn \__olympm_put_ref:N #1 {
  \tl_put_right:Nx #1
    { \exp_not:N \OlympOldEqref { \l__olympm_reflabel_tl } }
}

% ---- PART 8: the eq ENVIRONMENT -----------------------------------
%
%   \begin{eq}[<keys>] <math> \end{eq}
%
% With no keys, typesets EXACTLY like a bare `equation' -- but ALWAYS
% records a row (defaults filled in for anything not given): the
% whole point of `eq' vs plain `equation'/`align' is "please copy
% this into the marking scheme". Equations that should NOT be
% extracted should simply not use `eq'.
%
% Default label: eq:<OlympCurrentPrefix>.<n>, matching
% extract-solution.py's own default (see its `label_val =
% options.get('label', f'eq:{eq_counter:02d}')' plus the zero-padding
% note in the class file) -- \OlympCurrentPrefix supplies the human
% part (1, 1A, 2B, ...), \theequation supplies n (already reset to 0
% by every \solution/\subsolution, exactly mirroring
% extract-solution.py's own per-file counter).
\NewDocumentEnvironment{eq}{ O{} b }
  {
    \group_begin:
      \__olympm_eq_reset:
      \tl_set:Nn \l__olympm_captured_body_tl {#2}
      \SetKeys[olympm/eq]{#1}
      \__olympm_check_numpoints:
      \begin{equation}
        \tl_if_empty:NTF \l__olympm_label_tl
          { \label{eq:\OlympCurrentPrefix.\arabic{equation}} }
          { \label{\l__olympm_label_tl} }%
        #2
      \end{equation}
      \__olympm_record_eq:
    \group_end:
  }
  { }

\cs_new_protected:Npn \__olympm_record_eq: {
  \tl_if_empty:NTF \l__olympm_override_tl
    { \tl_set_eq:NN \l__olympm_shown_body_tl \l__olympm_captured_body_tl }
    { \tl_set_eq:NN \l__olympm_shown_body_tl \l__olympm_override_tl }

  % Freeze the two LIVE-but-safe-to-expand quantities immediately,
  % and the actual label used -- a custom `label=' REPLACES the
  % default eq:<prefix>.<n> label (amsmath errors on two \label's
  % for one equation), so the marking table's own clickable "(n)"
  % must target whichever label really exists, not always reconstruct
  % the default -- otherwise a custom-labelled equation would show
  % an unresolvable "(??)" in its own marking row.
  \tl_set:Nx \l__olympm_n_tl { \theequation }
  \tl_set:Nx \l__olympm_fullprefix_tl { \OlympCurrentPrefix }
  \tl_if_empty:NTF \l__olympm_label_tl
    { \tl_set:Nx \l__olympm_reflabel_tl { eq:\l__olympm_fullprefix_tl.\l__olympm_n_tl } }
    { \tl_set_eq:NN \l__olympm_reflabel_tl \l__olympm_label_tl }

  \int_gincr:N \g__olympm_rowid_int
  \__olympm_snapshot_piece:nN {pfx} \l__olympm_prefix_tl
  \__olympm_snapshot_piece:nN {sfx} \l__olympm_suffix_tl
  \__olympm_snapshot_piece:nN {bdy} \l__olympm_shown_body_tl

  % ---- primary row ----
  \tl_clear:N \l__olympm_row_tl
  \tl_if_eq:eeT {\l__olympm_type_tl} {alt} { \tl_put_right:Nn \l__olympm_row_tl { \quad \textit \bgroup } }
  \tl_if_empty:NTF \l__olympm_prefix_tl
    { \tl_put_right:Nn \l__olympm_row_tl { \OlympStringFallback{eq_formula} } }
    { \__olympm_put_piece:Nn \l__olympm_row_tl {pfx} }
  \tl_put_right:Nn \l__olympm_row_tl { ~ }
  \__olympm_put_ref:N \l__olympm_row_tl
  \tl_put_right:Nn \l__olympm_row_tl { :~$ }
  \__olympm_put_piece:Nn \l__olympm_row_tl {bdy}
  \tl_put_right:Nn \l__olympm_row_tl { $ }
  \__olympm_put_piece:Nn \l__olympm_row_tl {sfx}
  \tl_if_eq:eeT {\l__olympm_type_tl} {alt} { \tl_put_right:Nn \l__olympm_row_tl { \egroup } }
  \tl_put_right:Nn \l__olympm_row_tl { & }
  \tl_if_eq:eeT {\l__olympm_type_tl} {alt} { \tl_put_right:Nn \l__olympm_row_tl { \textit \bgroup } }
  \tl_if_empty:NTF \l__olympm_points_tl
    { \tl_put_right:Nn \l__olympm_row_tl { \textbf{?} } }
    { \tl_put_right:Nx \l__olympm_row_tl { \l__olympm_points_tl } }
  \tl_if_eq:eeT {\l__olympm_type_tl} {alt} { \tl_put_right:Nn \l__olympm_row_tl { \egroup } }
  \tl_put_right:Nn \l__olympm_row_tl { \\ \hline }
  \__olympm_snapshot_row:
  \tl_if_eq:eeF {\l__olympm_type_tl} {alt}
    { \exp_args:No \__olympm_addpoints:n \l__olympm_points_tl }

  % ---- optional second row: numerical value ----
  \bool_if:NT \l__olympm_numpoints_present_bool
    {
      \int_gincr:N \g__olympm_rowid_int
      \tl_clear:N \l__olympm_row_tl
      \tl_if_eq:eeT {\l__olympm_type_tl} {alt} { \tl_put_right:Nn \l__olympm_row_tl { \quad \textit \bgroup } }
      \tl_put_right:Nn \l__olympm_row_tl { \OlympStringFallback{eq_numerical}~ }
      \__olympm_put_ref:N \l__olympm_row_tl
      \tl_if_eq:eeT {\l__olympm_type_tl} {alt} { \tl_put_right:Nn \l__olympm_row_tl { \egroup } }
      \tl_put_right:Nn \l__olympm_row_tl { & }
      \tl_if_eq:eeT {\l__olympm_type_tl} {alt} { \tl_put_right:Nn \l__olympm_row_tl { \textit \bgroup } }
      \tl_put_right:Nx \l__olympm_row_tl { \l__olympm_numpoints_tl }
      \tl_if_eq:eeT {\l__olympm_type_tl} {alt} { \tl_put_right:Nn \l__olympm_row_tl { \egroup } }
      \tl_put_right:Nn \l__olympm_row_tl { \\ \hline }
      \__olympm_snapshot_row:
      \tl_if_eq:eeF {\l__olympm_type_tl} {alt}
        { \exp_args:No \__olympm_addpoints:n \l__olympm_numpoints_tl }
    }
}

% ---- PART 9: \criterion AND \showmarking --------------------------
\NewDocumentCommand{\criterion}{ O{} m }
  {
    \group_begin:
      \__olympm_criterion_reset:
      \SetKeys[olympm/criterion]{#1}
      \tl_set:Nn \l__olympm_suffix_tl {#2} % reuse the suffix slot as scratch for #2
      \int_gincr:N \g__olympm_rowid_int
      \__olympm_snapshot_piece:nN {txt} \l__olympm_suffix_tl
      \tl_clear:N \l__olympm_row_tl
      \tl_if_eq:eeT {\l__olympm_type_tl} {alt} { \tl_put_right:Nn \l__olympm_row_tl { \quad \textit \bgroup } }
      \__olympm_put_piece:Nn \l__olympm_row_tl {txt}
      \tl_if_eq:eeT {\l__olympm_type_tl} {alt} { \tl_put_right:Nn \l__olympm_row_tl { \egroup } }
      \tl_put_right:Nn \l__olympm_row_tl { & }
      \tl_if_eq:eeT {\l__olympm_type_tl} {alt} { \tl_put_right:Nn \l__olympm_row_tl { \textit \bgroup } }
      \tl_if_empty:NTF \l__olympm_points_tl
    { \tl_put_right:Nn \l__olympm_row_tl { \textbf{?} } }
    { \tl_put_right:Nx \l__olympm_row_tl { \l__olympm_points_tl } }
      \tl_if_eq:eeT {\l__olympm_type_tl} {alt} { \tl_put_right:Nn \l__olympm_row_tl { \egroup } }
      \tl_put_right:Nn \l__olympm_row_tl { \\ \hline }
      \__olympm_snapshot_row:
      \tl_if_eq:eeF {\l__olympm_type_tl} {alt}
        { \exp_args:No \__olympm_addpoints:n \l__olympm_points_tl }
    \group_end:
  }

\cs_new:Npn \__olympm_typeset_row:n #1 { \tl_use:c { g__olympm_row_ #1 _tl } }

