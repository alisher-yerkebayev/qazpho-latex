% ---- \OlympJuryPick -- generic type=solutions/marking switch ------
% Used by extract-marking.py's generated marking_ru.tex / marking_kz.tex
% to let ONE generated file serve both a type=solutions compile and a
% type=marking compile: header row, the extra MP/A columns on every
% row, intra-group \cline widths, the total row, and the mid-table
% \pagebreak all differ between the two -- picked here via
% \ifOlympJury rather than in Python, since \documentclass (and hence
% the type) never appears inside solution.tex itself.
%
% Safe for ordinary running text / table CELLS (used there as a normal
% 2-argument macro, expanding like any other macro call during
% typesetting). NOT safe inside a tabularx COLUMN-SPEC argument, e.g.
% \begin{tabularx}{\linewidth}{\OlympJuryPick{A}{B}}: array/tabularx's
% preamble scanner (\@mkpream/\@testpach) walks that argument ONE
% TOKEN AT A TIME, expanding each token in isolation to see what
% column-type it names. \OlympJuryPick is a 2-argument macro, so
% "expanding" the lone \OlympJuryPick token makes TeX go hunting for
% its {A}{B} arguments in whatever happens to follow inside array's
% own internal scanning code -- NOT the two braces actually written
% next to it -- and array errors out with something like "Illegal
% pream-token (\OlympJuryPick): `c' used". This is true no matter how
% \OlympJuryPick itself is defined (even a 0-argument macro that
% expands to several column-spec tokens in one go breaks the same
% way, since the scanner only re-processes ONE further token of the
% expansion). Use \OlympJuryBeginTable (below) for the column spec.
%
% Two more hard-won constraints on using \OlympJuryPick INSIDE a table:
%  * Each branch must be a COMPLETE physical row (from the first cell
%    through the trailing \\), never a partial fragment like "{}{ & &
%    X}" meant to splice extra trailing cells onto a row shared with
%    the OTHER branch. A bare alignment-tab (&) sitting inside the
%    SKIPPED branch, in the middle of an otherwise-shared row, desyncs
%    \halign's row/column bookkeeping and raises "Incomplete \iffalse"
%    once enough of the table has been read for it to surface --
%    reproducible with nothing but plain \iffalse & \fi inside a bare
%    tabular row, no \OlympJuryPick involved. extract-marking.py's
%    build_rows() always emits whole rows for exactly this reason.
%  * Never put \begin{env}/\end{env} inside a \OlympJuryPick argument
%    (e.g. to conditionally close/reopen the tabularx mid-table): LaTeX
%    needs to encounter \begin/\end directly in the main input stream,
%    not read as captured macro-argument text, or you get "Extra }, or
%    forgotten $." / "Missing } inserted" depending on which branch is
%    active. Emit the \end{tabularx}/\OlympJuryBeginTable/\begin{...}
%    sequence unconditionally instead (\OlympJuryBeginTable already
%    resolves per \ifOlympJury, so in the untaken mode it's an
%    invisible same-colspec seam), and wrap only small, &-free
%    fragments like \pagebreak or a single repeated header row in their
%    own \OlympJuryPick{}{...}. See extract-marking.py's
%    generate_marking_tex() for the working pattern.
\newcommand{\OlympJuryPick}[2]{\ifOlympJury#2\else#1\fi}

% ---- \OlympJuryBeginTable -- switchable tabularx COLUMN SPEC ------
% \OlympJuryBeginTable{<solutions colspec>}{<marking colspec>} opens
% the tabularx itself (i.e. replaces \begin{tabularx}{\linewidth}{...}
% -- the matching \end{tabularx} is written as usual). It sidesteps
% \OlympJuryPick's column-spec limitation (see above) by resolving
% \ifOlympJury...\fi down to the chosen branch's PLAIN CHARACTERS
% via a single \edef pass BEFORE \begin{tabularx} is invoked at all --
% safe, because both branches are literal, already-typeset-safe
% column-spec text: \centering/\arraybackslash are \protected
% (untouched by \edef), and \linewidth is a non-expandable register.
% By the time the real \begin{tabularx} call runs, array's scanner
% sees only ordinary characters, exactly as if the chosen colspec had
% been hand-written -- no macro call left for it to trip over.
\newcommand{\OlympJuryBeginTable}[2]{%
  \edef\Olymp@marktable@invoke{%
    \noexpand\begin{tabularx}{\linewidth}{\ifOlympJury#2\else#1\fi}%
  }%
  \Olymp@marktable@invoke
}

% ---- PART 10: \eqref shorthand ------------------------------------
% \eqref{#1} takes a BARE equation number (not a full label) and
% resolves it against the equation actually typeset under the CURRENT
% \OlympCurrentPrefix, i.e. eq:\OlympCurrentPrefix.#1 -- keeps
% marking.tex problem-order-agnostic (see file-level note on why
% \OlympCurrentPrefix must stay live/lazy here, never frozen).
%
% If that label is undefined -- which happens whenever this same
% marking.tex is compiled on its own in a type=marking document that
% never actually typesets the equations (so \label was never executed
% for them) -- \eqref falls back to printing the bare number in
% parentheses, "(#1)", instead of erroring or emitting "??". This lets
% ONE marking.tex serve both the solutions document (live, clickable
% cross-references) and the marking-only document (plain numbers)
% with no changes.
%
% A custom label=... given directly to \eq or \criterion does NOT
% follow the eq:\OlympCurrentPrefix.<n> pattern, so it is never routed
% through this shorthand -- reference it with \OlympOldEqref{<label>}
% instead, exactly as before.
\let\OlympOldEqref\eqref
\renewcommand{\eqref}[1]{%
  \@ifundefined{r@eq:\OlympCurrentPrefix.#1}%
    {\textup{(#1)}}%
    {\OlympOldEqref{eq:\OlympCurrentPrefix.#1}}%
}

% hyperref names each equation's PDF anchor from \theHequation, not
% \theequation -- left at its default, anchors from DIFFERENT blocks
% whose \theequation both reset to e.g. "1" collide ("destination
% with the same identifier"). \blocknum (olympiad.cls) is a single
% flat counter stepped once per \solution/\subsolution specifically
% so this can be a plain, single-parent \theHequation -- no chngcntr,
% no reliance on hyperref's own \@addtoreset-based auto-naming (which
% cannot work here: it only tracks counters created AFTER hyperref
% loads, and every counter in this system is created by olympiad.cls,
% which always loads before the user's own \usepackage{hyperref}).
\ExplSyntaxOn
\AtBeginDocument{
  \cs_if_exist:NT \theHequation
    { \renewcommand{\theHequation}{\arabic{blocknum}.\arabic{equation}} }
}
\ExplSyntaxOff

% =============================================
%%%%%%% MARKING SCHEME FOR EXPERIMENTS %%%%%%%%
% =============================================
% Remains mostly the same since Spring 2026 version

\newcounter{taskid} % task counter for mse
\setcounter{taskid}{0}
\newcounter{tasktotalrows}

% NOTE on why every command below is DUPLICATED wholesale into an
% \ifOlympJury branch and an \else branch, instead of writing one
% definition that puts a bare `\ifOlympJury&&&\fi' (or similar)
% INSIDE the table row it emits:
%
% TeX's alignment scanner (\halign, which tabularx/tabular both sit
% on top of) tracks row/column bookkeeping via a token-level counter
% that gets updated by EVERY `&' character TeX's tokenizer reads --
% including one sitting inside the UNTAKEN branch of an \iffalse it
% is currently skipping over. Conditional-skipping is a token-level
% scan, not a semantic one, so it does not "know" those `&'s will
% never be typeset; it still perturbs the bookkeeping. The result
% shows up much later (once the table's true row count is reached)
% as "Extra alignment tab has been changed to \cr", "Incomplete
% \iffalse", or "Extra \fi" -- reproducible with nothing more than a
% bare `\iffalse & \fi' anywhere inside a tabular row, no custom
% macros required. This bit the old `mse'/`blockbegin'/`bscheme'/
% `escheme'/`etotal' code exactly this way (see test-respa2026_expsol
% in test/): every marking-scheme-experiment table failed with this
% exact cascade under type=solutions.
%
% The fix is to resolve \ifOlympJury exactly ONCE, at package-load
% time (here), long before \halign ever starts reading a row, and
% commit to one COMPLETE, `&'-consistent macro body per mode. Each
% branch below emits the exact same cells the old single-body version
% did for that mode -- nothing else changes.
\ifOlympJury
\newenvironment{mse}{% Marking Scheme Experiment
\makegapedcells
  \setcounter{taskid}{0}%
  \tabularx{\linewidth}{
  |>{\centering\arraybackslash}p{0.045\linewidth}
  |>{\arraybackslash}p{0.545\linewidth}
  |>{\centering\arraybackslash}p{0.06\linewidth}
  |>{\centering\arraybackslash}p{0.03\linewidth}|>{\centering\arraybackslash}p{0.04\linewidth}
  |>{\centering\arraybackslash}p{0.04\linewidth}
  |>{\centering\arraybackslash}p{0.04\linewidth}
  |}%
    \hline
    \textbf{\textnumero} & \multicolumn{1}{c|}{\OlympString{marking_content}} & \multicolumn{2}{c|}{\OlympString{marking_points}} & \multicolumn{2}{c|}{\textbf{MP}} & \textbf{A}
}{%
  \setcounter{taskid}{0}%
  \endtabularx
}
\else
\newenvironment{mse}{% Marking Scheme Experiment
\makegapedcells
  \setcounter{taskid}{0}%
  \tabularx{\linewidth}{
  |>{\centering\arraybackslash}p{0.05\linewidth}
  |>{\arraybackslash}p{0.74\linewidth}
  |>{\centering\arraybackslash}p{0.08\linewidth}
  |>{\centering\arraybackslash}p{0.035\linewidth}|}%
    \hline
    \textbf{\textnumero} & \multicolumn{1}{c|}{\OlympString{marking_content}} & \multicolumn{2}{c|}{\OlympString{marking_points}}
}{%
  \setcounter{taskid}{0}%
  \endtabularx
}
\fi

% blockbegin / blockend: "Block-scheme" -- optionally, can be used to make a separate block with its own subparts \bscheme
% \blockbegin{<descriptor>}{<total-points>}{<nrows>}
\ifOlympJury
\NewDocumentCommand{\blockbegin}{m m m}{%
  \\ \hline \stepcounter{taskid}
  \setcounter{tasktotalrows}{#3}%
	\multirow{\thetasktotalrows}{*}{\textbf{M\thetaskid}}%
	&#1&&\multirow{\thetasktotalrows}{*}{\textbf{#2}}&&&%
}
\else
\NewDocumentCommand{\blockbegin}{m m m}{%
  \\ \hline \stepcounter{taskid}
  \setcounter{tasktotalrows}{#3}%
	\multirow{\thetasktotalrows}{*}{\textbf{M\thetaskid}}%
	&#1&&\multirow{\thetasktotalrows}{*}{\textbf{#2}}%
}
\fi

%\bscheme{<descriptor>}{<points>}
\ifOlympJury
\NewDocumentCommand{\bscheme}{m m}{%
    \\ \cline{5-5}\cline{7-7}
	& --- #1 & #2 &&&&
}
\else
\NewDocumentCommand{\bscheme}{m m}{%
    \\ % no \cline at all
	& --- #1 & #2 &
}
\fi

%\bremark{<descriptor>}{<points>} --- italicized \bscheme
\ifOlympJury
\NewDocumentCommand{\bremark}{m m}{%
    \\ % no \cline at all
	& ---\ --- \textit{#1} & \textit{#2} &&&&
}
\else
\NewDocumentCommand{\bremark}{m m}{%
    \\ % no \cline at all
	& ---\ --- \textit{#1} & \textit{#2} &
}
\fi

\NewDocumentCommand{\blockend}{}{%
  % cleanup
  \setcounter{tasktotalrows}{0}%
}

% \escheme: "exp-scheme", a standard single-line scheme
% \escheme{<descriptor>}{<points>}
\ifOlympJury
\NewDocumentCommand{\escheme}{m m}{%
  \\ \hline \stepcounter{taskid}
	\textbf{M\thetaskid}%
	&#1&\multicolumn{2}{|c|}{#2}&&&%
}
\else
\NewDocumentCommand{\escheme}{m m}{%
  \\ \hline \stepcounter{taskid}
	\textbf{M\thetaskid}%
	&#1&\multicolumn{2}{|c|}{#2}%
}
\fi

