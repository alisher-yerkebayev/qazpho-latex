\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{olympiad-layout}[2027/01/01 v1.5 Style-agnostic layout layer]

% ============================================================
%  olympiad-layout.sty
%  Visual design layer for olympiad documents.
%
%  Requires: olympiad.cls (loaded first)
%
%  CHANGELOG v1.1 -> v1.2
%    - \problemsheader introduced. \enlargethispage / \textheight
%      changes placed inside \fancypagestyle{firstpage}{...} were
%      silent no-ops: that code only runs at \shipout (output
%      routine) time, well after the page-breaking decision (which
%      depends on \textheight) has already been made. \problemsheader
%      calls \enlargethispage at the correct time -- in the main
%      vertical list, before the page breaks -- then sets the page
%      style. Use it instead of \thispagestyle{firstpage} directly
%      in title_ru.tex / title_kz.tex / etc.
%
%  CHANGELOG v1.2 -> v1.3
%    - Whole file gated behind \ifOlympStyleRespa (olympiad.cls's new
%      style=... option, default respa) -- this file was always
%      respa's own visual convention, never truly competition-
%      agnostic, so it's now explicit rather than implicit. A future
%      non-respa style is a sibling \ifOlympStyle...{...}\fi block
%      appended at the end of this same file, not a new .sty.
%
%  STYLE GATING
%    Everything below (PARTS 1-10) is the "respa" style specifically
%    -- respa's own page geometry, typography, headers/footers,
%    figure and answer-box commands, all of it -- gated on
%    \ifOlympStyleRespa (olympiad.cls, style=respa, the default). It
%    is NOT competition-agnostic: a different olympiad style with its
%    own visual conventions gets its OWN \ifOlympStyle...{...}\fi
%    block, appended below \OlympLayoutMatchedtrue and all, as a
%    sibling of the respa block -- not nested inside it, and not a
%    separate .sty file. olympiad.cls stays out of this decision
%    entirely: it only hosts the style key/conditionals (like
%    language/tour/type), never branches on style itself.
%
%  CHANGELOG v1.3 -> v1.4
%    - Engine switch to XeLaTeX (see olympiad.cls's v1.5 changelog):
%      added a "PART 0 — FONTS" subsection at the top of the
%      \ifOlympStyleRespa block selecting CMU Serif/CMU Sans Serif/CMU
%      Typewriter Text explicitly (with Ligatures=TeX -- load-bearing,
%      not cosmetic) so respa's look survives the engine change as
%      closely as possible. Latin Modern was tried first and rejected
%      -- see the PART 0 comment below for why.
%
%  CHANGELOG v1.4 -> v1.5
%    - Branched out most of the content to separate files;
%      Added `olympiad-respa.sty` (the standard one) and
%      `olympiad-ipho.sty`. The content here is style-independent,
%      and is universal to any styles loaded there. This file's own
%      \ifOlympStyle...\fi branching below is what loads the right
%      one -- \usepackage{olympiad-layout} stays the single, style-
%      independent line every document's preamble uses; documents
%      never \usepackage{olympiad-respa}/{olympiad-ipho} directly
%      (fixed: those two \RequirePackage lines were briefly commented
%      out while testing loading olympiad-respa directly from a
%      document instead -- that ordering is wrong, because
%      olympiad-respa.sty's own \RequirePackage{olympiad-layout} at
%      its top means THIS file's \ifOlympLayoutMatched check below
%      would run and fire its "no layout matched" warning BEFORE
%      olympiad-respa.sty gets a chance to run its own
%      \OlympLayoutMatchedtrue -- the check has to happen after the
%      branching, in the same file, which is exactly why this file
%      does the branching instead of leaving it to each document).
% ============================================================

\newif\ifOlympLayoutMatched
\OlympLayoutMatchedfalse

% \ifOlympShowPoints (used by \answerbox/\answerboxpart, PART 10) MUST
% be \newif'd out here, BEFORE the \ifOlympStyleRespa gate below, even
% though it's only ever USED inside the respa-specific block: a
% \newif'd conditional only becomes a real TeX conditional once its
% \newif actually RUNS. If both the \newif AND a `\ifOlympShowPoints
% ... \fi' branch using it sit inside the SAME skipped (style !=
% respa) region, TeX's low-level \fi-skip scanner -- which matches
% \if/\fi by each token's CURRENT meaning, blind to macro-argument
% grouping -- never saw \ifOlympShowPoints become a conditional, so it
% doesn't count that \if, and the \fi that was meant to close it
% closes \ifOlympStyleRespa itself instead: skipping ends early and
% TeX starts executing raw layout code as real content, corrupting
% the rest of the document with cascading brace/undefined-control-
% sequence errors. Confirmed by forcing \ifOlympStyleRespa false in a
% smoke test. Any FUTURE \newif declared anywhere below needs the
% same treatment: move the bare \newif (not its default-value setting
% or the commands that flip it) up here.
\newif\ifOlympShowPoints
\OlympShowPointstrue

% ============================================================
% PACKAGE LOADING ORDER
% ============================================================
% siunitx must be loaded before tabularx/array so it can claim
% the S column type without triggering the "overwritten" warning.
% NOTE: olympiad.cls already loads siunitx; this second
% \RequirePackage{siunitx} is a harmless no-op (siunitx tracks that
% it's already loaded and skips re-running its own setup code).

\RequirePackage{siunitx}         % loaded first — owns the S column
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{paracol} % Required for simultaneous parallel columns
\RequirePackage{multirow}
\RequirePackage{makecell}
\RequirePackage[normalem]{ulem}
\RequirePackage{cellspace}
\setcellgapes{1pt}
\setlength\cellspacetoplimit{1pt}
\setlength\cellspacebottomlimit{1pt}
\setlength{\extrarowheight}{2pt}

\RequirePackage{enumitem}
\RequirePackage{wrapfig}
\RequirePackage{float}
\restylefloat{figure}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
% hyperref last among layout packages
%
% hypertexnames=false is NOT optional: by default (hypertexnames=true),
% hyperref's automatic per-page PDF destination is named directly from
% the `page' counter's value (see hyperref.sty's \Hy@EveryPageAnchor --
% traced directly in the installed package source, not assumed).
% respa's \problemsheader (olympiad-respa.sty) -- and every
% \problem/\solution call in olympiad-ipho.sty -- do
% \setcounter{page}{1} well after the title/instructions pages already
% used up page 1 (and 2, ...), so the counter repeats, and xdvipdfmx
% then warns "Object @page.N already defined" for every repeated value
% (silently dropping the second destination, breaking whichever
% \pageref pointed at it). hypertexnames=false switches that anchor's
% name to hyperref's OWN internal, monotonically-incrementing
% \Hy@pagecounter instead -- never reset, so never collides, and
% \pageref{LastPage}/lastpage still resolve normally since they don't
% care what the anchor is literally named. (plainpages=false, the more
% commonly-cited option for "page numbers aren't unique", does NOT fix
% this: per the same source, it only changes the anchor name from the
% raw counter to \thepage's FORMATTED string, e.g. for mixed roman/
% arabic numbering -- ours stays plain arabic throughout, so that
% branch produces the exact same colliding name either way. Confirmed
% empirically: adding plainpages=false alone left the warnings
% unchanged.) This is the same class of bug \theHequation already
% fixes in olympiad-marking.sty (multiple \solution/\subsolution blocks
% each resetting `equation' to 0) and \theHtaskalphanum fixes below
% (same idea, different hyperref mechanism -- \label-keyed counters
% go through \theH<name>, but this automatic per-page anchor has its
% own separate hypertexnames switch). Do NOT "fix" this instead via
% \hypersetup{pageanchor=false} + \pageref*{LastPage} (tried and
% reverted): that trades the warning for dead \pageref{LastPage} links
% (lastpage's own "link does not work... using hyperref with disabled
% option `pageanchor'" warning is telling the truth) -- hypertexnames
% =false keeps the links live AND unique.
\RequirePackage[colorlinks=true, linkcolor=., citecolor=black, final, hypertexnames=false]{hyperref}
\RequirePackage{lastpage}

% \theHtaskalphanum: same disambiguation \theHequation already applies
% to `equation' -- taskalphanum (task[type=subproblem]'s (a)/(b)/(c)
% counter) is DELIBERATELY reset to 0 at the start of every such list
% (see olympiad-respa.sty/olympiad-ipho.sty's task environment: "always
% starts at (a) regardless of any other task[type=subproblem] elsewhere
% in the document"), so \refstepcounter{taskalphanum}'s hyperref
% destination collides ("Object @taskalphanum.N already defined")
% the moment a SECOND such list appears anywhere in the document.
% \OlympCurrentPrefix is exactly the qualifier already used to keep
% \thefigure unique per problem/subproblem block for the same reason --
% reuse it here instead of inventing a new counter.
\ExplSyntaxOn
\AtBeginDocument{
  \cs_if_exist:NT \theHtaskalphanum
    { \renewcommand{\theHtaskalphanum}{\OlympCurrentPrefix.\alph{taskalphanum}} }
}
\ExplSyntaxOff

\RequirePackage{tikz}
\RequirePackage{circuitikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

\RequirePackage{pdflscape}
\RequirePackage{ltablex}

\RequirePackage{geometry}


% Only \normalsize itself is touched (matches the reference marking.tex
% this was ported from): \small, \footnotesize, \large, etc. keep
% whatever absolute size article.cls assigned them for the class's
% ORIGINAL base size -- intentional, not an oversight, since those
% are mostly used for headings/labels that should stay legible
% relative to the now-smaller body text, not shrink proportionally
% with it.

% ============================================================
% FIGURE COMMANDS
% Known issues:
%   - They don't support multiline PDF-formatted figures with .IPE metadata
% ============================================================

\NewDocumentCommand{\pic}{ m m m m m o }{%
  \begin{wrapfigure}[#1]{#2}{#4\linewidth}
    \centering
    \vspace{#3}%
    \includegraphics[width=\linewidth]{#5}%
    \IfValueT{#6}{%
      \vspace{-6pt}%
      \refstepcounter{figcounter}%
      \expanded{\noexpand\label{fig:\OlympCurrentPrefix.\thefigcounter}}%
      \captionsetup{width=\linewidth}%
      \caption{\footnotesize\textit{#6}}%
    }%
  \end{wrapfigure}%
}

\NewDocumentCommand{\cpic}{ m m o }{%
  \begin{center}
    \vspace{6pt}%
    \includegraphics[width=#1\linewidth]{#2}%
    \IfValueT{#3}{%
      \vspace{-6pt}%
      \refstepcounter{figcounter}%
      \expanded{\noexpand\label{fig:\OlympCurrentPrefix.\thefigcounter}}%
      \captionsetup{width=\linewidth, hypcap=false}%
      \captionof{figure}{\footnotesize\textit{#3}}%
    }%
  \end{center}%
}

\NewDocumentCommand{\cpics}{ m m m m o }{%
  \begin{center}
    \vspace{6pt}%
    \includegraphics[width=#1\linewidth]{#2}%
    \includegraphics[width=#3\linewidth]{#4}%
    \IfValueT{#5}{%
      \vspace{-6pt}%
      \refstepcounter{figcounter}%
      \expanded{\noexpand\label{fig:\OlympCurrentPrefix.\thefigcounter}}%
      \captionsetup{width=\linewidth, hypcap=false}%
      \captionof{figure}{\footnotesize\textit{#5}}%
    }%
  \end{center}%
}

% ============================================================
% CAPTION TYPOGRAPHY
% ============================================================

\captionsetup[figure]{
  font       = {footnotesize, it},
  labelfont  = {footnotesize, it},
}

% ============================================================
% REFERENCES TO FIGURES
% ============================================================

\newcommand{\figref}[1]
{%
  \ifOlympProblems%
  \arabic{problemnum}\printcounter{subproblemnum}.\ref{fig:\OlympCurrentPrefix.#1}%
  \fi%
  \ifOlympSolutions%
  \arabic{solnum}\printcounter{subsolnum}.\ref{fig:\OlympCurrentPrefix.#1}%
  \fi%
}
% (figcounter resets per \problem/\subproblem/\subsolution, see
% Part 5/9). Authors never type or track the problem number
% themselves: \OlympCurrentPrefix is resolved at compile time, so
% figure references survive problems being reordered/renumbered by
% build.py. Pairs with the label key that \pic/\cpic/\cpics in
% olympiad-layout.sty must use:
%   \label{fig:\OlympCurrentPrefix.\thefigcounter}

% ============================================================
% — WRAPFIGURE UNDERFULL HBOX SUPPRESSION
% ============================================================

\RequirePackage{etoolbox}
\AtBeginEnvironment{wrapfigure}{%
  \setlength{\emergencystretch}{1em}%
}

