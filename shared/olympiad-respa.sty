\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{olympiad-respa}[2027/01/01 Respa-style olympiad-layout extension]
\RequirePackage{olympiad-layout}

\OlympLayoutMatchedtrue

% ============================================================
% FONTS --- 12pt as defined by .cls
% ============================================================
% respa's whole look predates XeLaTeX: under pdfLaTeX it never chose a
% font package at all, just whatever fontenc[T2A,T1]+babel-russian
% defaulted to (Computer Modern for Latin glyphs, the separate "lh"
% Cyrillic project's glyphs for Cyrillic).
%
% Ligatures=TeX is NOT optional: this repo's problem/solution prose
% relies on classic TeX ligatures (---  for em-dash, `` / '' for curly
% quotes) thousands of times across the corpus. Without this key on an
% OpenType font, fontspec disables them and every one of those renders
% as literal hyphens/straight quotes.
\setmainfont{CMU Serif}[Ligatures=TeX]
\setsansfont{CMU Sans Serif}[Ligatures=TeX]
\setmonofont{CMU Typewriter Text}[Ligatures=TeX]
% No unicode-math: math mode keeps the classic TeX math fonts
% (cmsy/cmex/msam/msbm via amssymb, loaded in olympiad.cls). Safe to
% mix with an OpenType text font -- CMU Serif and Computer Modern
% share the same metric/design lineage, so there's no italic-
% correction or weight mismatch between text and math.


% ============================================================
% PAGE GEOMETRY
% ============================================================

\geometry{
  a4paper,
  left        = 12mm,
  right       = 12mm,
  top         = 12mm,
  bottom      = 15mm,
  headheight  = 15pt,
  headsep     = 6pt,
  footskip    = 15pt,
  includehead,
}

% type=marking prints a dense, jury-facing scheme table (extra MP/A
% columns, MP-per-criterion rows -- see olympiad-marking.sty) rather
% than prose, so it trades the normal reading-friendly margins for
% tighter ones to fit more table per page. Deliberately a SECOND
% \geometry{...} call (not baked into the block above) so a plain
% type=solutions/problems compile keeps its original margins byte-
% for-byte -- \ifOlympJury is only known once olympiad.cls (loaded
% before this package) has run its \DeclareKeys/\ProcessKeyOptions.
\ifOlympJury
  \geometry{
    left   = 5mm,
    right  = 5mm,
    top    = 5mm,
    bottom = 5mm,
  }
\setlength{\parindent}{0pt}
\renewcommand{\normalsize}{\fontsize{11}{12}\selectfont}%
\normalsize
\fi %\ifOlympJury

% ============================================================
% TYPOGRAPHY
% ============================================================

\ifOlympProblems\setlength{\parindent}{18pt}\fi
\ifOlympSolutions\setlength{\parindent}{0pt}\fi

\setlength{\parskip}{0pt}
\setlength{\intextsep}{0pt}      % no extra space around floats

% ============================================================
% LIST CONFIGURATION
% ============================================================

\setlist[itemize]{topsep=0pt, noitemsep}
\setlist[itemize,1]{label={\tiny\textbullet}}
\setlist[enumerate]{topsep=0pt, leftmargin=38pt, noitemsep}
\setlist[enumerate,1]{label=\arabic*)}

% ============================================================
% task ENVIRONMENT
% ============================================================
%
% Wraps numbered sub-tasks within a problem statement.
% Each \item auto-increments tasknum and produces label "N.M"
% where N = \theproblemnum, M = \arabic{tasknum}.
%
% \begin{task}[type=subproblem] ... \end{task}
%   Same list, but labels each \item "(a)", "(b)", "(c)", ... instead
%   of the numbered "N.M" style -- for a task that's really a set of
%   lettered/alternative sub-parts (e.g. "(a) ... (b) ...") rather
%   than a fresh top-level numbered task. Aliases: type=alternative,
%   type=alphabetic -- all three are identical; pick whichever reads
%   best at the call site. An unrecognised type=... value warns and
%   falls back to the default numbered style (mirrors \eq/\criterion
%   in olympiad-marking.sty).
%
%   Uses its own counter (taskalphanum, Part 5), reset to 0 at the
%   START of every type=subproblem block, so each such list is
%   self-contained and always starts at (a) regardless of any other
%   task[type=subproblem] elsewhere in the document. This replaces an
%   ad hoc \newcounter{taskstar}-per-file pattern some problems
%   hand-rolled for the same effect, which breaks the moment a SECOND
%   file needing it is \input into the same document (\newcounter
%   errors on a name already taken).
%
% Deliberately uses raw list — no enumitem keys here.
% olympiad-layout.sty issues \setlist or patches this env
% to control spacing, indentation, and font.
% ============================================================

\ExplSyntaxOn

\bool_new:N \l__olymp_task_alphabetic_bool

\DeclareKeys[olymp/task]
  {
    type .code:n = {
      \str_case:nnF {#1}
        {
          {subproblem}  { \bool_set_true:N \l__olymp_task_alphabetic_bool }
          {alternative} { \bool_set_true:N \l__olymp_task_alphabetic_bool }
          {alphabetic}  { \bool_set_true:N \l__olymp_task_alphabetic_bool }
        }
        {
          \ClassWarning{olympiad}
            { type=#1~is~not~recognised~by~the~task~environment~(only~subproblem~/~alternative~/~alphabetic~are);~using~the~default~numbered~style }
        }
    } ,
  }

\NewDocumentEnvironment{task}{ O{} }
  {
    \bool_set_false:N \l__olymp_task_alphabetic_bool
    \SetKeys[olymp/task]{#1}
    \bool_if:NT \l__olymp_task_alphabetic_bool { \setcounter{taskalphanum}{0} }
    \begin{list}{}{
      \setlength{\leftmargin}{18pt}
      \setlength{\labelwidth}{0pt}
      \setlength{\labelsep}{0pt}
      \bool_if:NTF \l__olymp_task_alphabetic_bool
        {
          \renewcommand{\makelabel}[1]{
            \refstepcounter{taskalphanum}
            \textbf{(\alph{taskalphanum})}~
          }
        }
        {
          \renewcommand{\makelabel}[1]{
            \refstepcounter{tasknum}
            \textbf{\theproblemnum\printcounter{subproblemnum}.\arabic{tasknum}}~
          }
        }
    }
  }
  {
    \end{list}
  }

\ExplSyntaxOff

\AtBeginEnvironment{task}{%
  \setlength{\itemsep}{6pt}%
  \setlength{\topsep}{6pt}%
}

% ============================================================
% \tasksol, \taskref, \solref
% ============================================================
%
% \tasksol  — starts a solution sub-task, incrementing
%             tasksolnum and printing the "N.M" label
% \taskref{M} — bold reference to sub-task M of current problem
% \solref{M}  — bold reference to sub-task M of current solution
%
% \figref{N} — reference the Nth picture within the CURRENT
%   problem/subproblem or solution/subsolution block. Delegates to
%   \OlympCurrentPrefix instead of reconstructing the
%   \ifOlympProblems/\ifOlympSolutions branch locally -- see that
%   macro's own comment for why.
%
% The \hspace* mirrors task's leftmargin; layout can adjust.
% ============================================================

\newcommand{\tasksol}{%
  \vspace{6pt}%
  \hspace*{18pt}%
  \stepcounter{tasksolnum}%
  \textbf{\thesolnum.\thetasksolnum}~%
}

\newcommand{\taskref}[1]{\textbf{\theproblemnum.#1}}
\newcommand{\solref}[1]{\textbf{\thesolnum.#1}}


% ============================================================
% PROBLEM AND SOLUTION HEADING TYPOGRAPHY
% ============================================================

\newcommand{\OlympProblemHeading}[1]{%
  \centerline{\large\textbf{#1}}%
}

\newcommand{\OlympSolutionHeading}[1]{%
  \centerline{\large\textbf{#1}}%
}

\renewcommand{\part}[1]{%
    \vspace{6pt}
    \centerline{\textbf{#1}}
}

% ============================================================
% \problem
% ============================================================
%
% \problem{Title}{Points}
%   Title — problem title, passed by build.py from problem.yaml
%   Points — point value string, already grammatically correct
%            (build.py resolved "10 баллов" / "10 ұпай")
%
% The command sets the LaTeX counter to N (for \taskref cross-
% references), resets tasknum, starts a new page, and calls
% \OlympProblemHeading which layout can redefine.
%
% No starred variant. No hardcoded subtitle text.
% If a problem needs "three independent parts" text, that is
% content — it goes in the problem's .tex file directly.
% ============================================================

\newcommand{\problem}[2]{%
  % #1 = title, #2 = points string
  \stepcounter{problemnum}%
  \setcounter{subproblemnum}{0}%
  \setcounter{tasknum}{0}%
  \setcounter{figcounter}{0}%
  \par%
  \OlympProblemHeading{%
    \ifOlympTheory\OlympString{problem}~\theproblemnum.~\fi#1~(#2 \OlympString{points_long})%
  }%
}

% ============================================================
% \solution
% ============================================================
%
% \solution{Title}{Points}
%   #1 = title, #2 = points string. Auto-numbers via \thesolnum
%   Sets solnum and resets tasksolnum/subsolnum/equation counter.
%   Under type=jury (\ifOlympJury), the heading additionally
%   appends "--- \OlympString{marking_scheme}" -- competition .sty /
%   strings-*.tex files must define OlympStr@marking_scheme@<lang>
%   for this (e.g. \SetOlympString{marking_scheme}{Марк-схема}), same
%   as any other \OlympString slot. \subsolution does the same.
%
% ============================================================

\newcommand{\solution}[2]{%
  % #1 = title, #2 = points string
  \stepcounter{solnum}%
  \setcounter{tasksolnum}{0}%
  \setcounter{subsolnum}{0}%
  \setcounter{equation}{0}%
  \stepcounter{blocknum}%
  \par%
  \OlympSolutionHeading{%
    \ifOlympTheory\OlympString{problem}~\thesolnum.~\fi#1~(#2 \OlympString{points_long})%
  }%
}

% ============================================================
% \subproblem and \subsolution
% ============================================================
%
% \subproblem{Label}{Points}
%   For the multi-part Problem 1 pattern (parts А, Б, В).
%   Label  — single letter or short label, e.g. "А"
%   Points — already-formatted string from build.py
%
%   \subsolution increments solnum so that \eq numbering
%   and \eqref refs remain consistent across sub-problems.
%   Resets tasksolnum and equation counter per sub-solution.
%
%   Heading uses slot "subproblem" so competition .sty can
%   set:  \def\OlympStr@subproblem@ru{Задача 1A}
%         \def\OlympStr@subproblem@kz{Есеп 1A}
%   and:  \def\OlympStr@subsolution@ru{Задача 1A}
%         \def\OlympStr@subsolution@kz{Есеп 1A}
%
%   \par (not \newline): \newline requires being mid-paragraph
%   (horizontal mode). Right after a \centerline-based heading TeX
%   is in vertical mode with no current line, so \newline there
%   raised "There's no line here to end" the moment a blank line
%   preceded the next \subproblem/\subsolution. \par is safe in
%   both modes.
% ============================================================

\newcommand{\subproblem}[2]{%
  % #1 = label (e.g. А), #2 = points string
  \setcounter{figcounter}{0}%
  \stepcounter{subproblemnum}%
  \par%
  \centerline{\textbf{\OlympString{problem}~\theproblemnum\printcounter{subproblemnum}.~#1~(#2 \OlympString{points_short})}}%
}

\newcommand{\subsolution}[2]{%
  % #1 = label (e.g. А), #2 = points string
  \stepcounter{subsolnum}%
  \setcounter{tasksolnum}{0}%
  \setcounter{equation}{0}%
  \setcounter{figcounter}{0}%
  \stepcounter{blocknum}%
  \par%
  \vspace{6pt}%
  \ifOlympJury
    \centerline{\textbf{\OlympString{problem}~\thesolnum\printcounter{subsolnum}.~#1~(#2 \OlympString{points_short})~---~\OlympString{marking_scheme}}}%
  \else
    \centerline{\textbf{\OlympString{problem}~\thesolnum\printcounter{subsolnum}.~#1~(#2 \OlympString{points_short})}}%
  \fi
}

% ============================================================
% HEADERS AND FOOTERS
% ============================================================

\RequirePackage{fancyhdr}

% Shared right header (Page n/N)
\newcommand{\OlympCommonRightHead}{%
  \fancyhead[R]{\textbf{\OlympString{page_abbrev}~\thepage/\pageref{LastPage}}}%
}

% Both adjustments are tied to \problemsheaderExtra so the amount
% "stolen" from the page and the amount added to \headsep can never
% drift out of sync.
\newlength{\problemsheaderExtra}
\setlength{\problemsheaderExtra}{6mm}

% 1. "problems" Style
\fancypagestyle{problems}{%
  \fancyhf{}% Clear all headers and footers
  \OlympCommonRightHead%
  \fancyhead[L]{%
    \textbf{\OlympString{name}~\OlympYear/\OlympString{tourname}}%
  }%
  \fancyfoot[L]{\textbf{\OlympString{duration}}}
}

% 2. "solutions" Style
\fancypagestyle{solutions}{%
  \fancyhf{}% Clear all headers and footers
  \OlympCommonRightHead%
  \fancyhead[L]{%
    \textbf{\OlympString{name}~\OlympYear/\OlympString{tourname}/\OlympString{solutions}}%
  }%
}

% 3. "marking" Style
\fancypagestyle{marking}{%
  \fancyhf{}% Clear all headers and footers
  \OlympCommonRightHead%
  \fancyhead[L]{%
    \textbf{\OlympString{name}~\OlympYear/\OlympString{tourname}/\OlympString{marking_schemes}}%
  }%
}

% 4. "answersheets" Style
\fancypagestyle{answersheets}{%
  \fancyhf{}% Clear all headers and footers
  \OlympCommonRightHead%
  \fancyhead[L]{%
    \textbf{\OlympString{name}~\OlympYear/\OlympString{tourname}/\OlympString{answersheets}}%
  }%
  \fancyfoot[L]{\textbf{\OlympString{duration}}}
}

\fancypagestyle{firstpage}{%
  \fancyhf{}%
  \addtolength{\headsep}{-\problemsheaderExtra}%
  \fancyhead[C]{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[L]{%
    \textbf{%
      \OlympString{duration}%
    }%
  }%
}

% ==========================================
% Initial State Activation
% ==========================================
\ifOlympJury
  \pagestyle{empty}
\else
  \ifOlympSolutions
    \pagestyle{solutions}
  \else
    \ifOlympMarking
      \pagestyle{marking}
    \else
      \pagestyle{problems}
    \fi
  \fi
\fi

% \problemsheader — use this instead of \thispagestyle{firstpage}
% directly, in title_ru.tex and any other language variant.
%
\newcommand{\problemsheader}{%
  \setcounter{page}{1}
  \thispagestyle{firstpage}%
  \begin{tabular}[c]{@{}c@{}}
      \textbf{\underline{\OlympString{organizer}}} \\[2pt]
      \textbf{\underline{\OlympString{firstpagesubtitle}}}\\
  \end{tabular}%
  \vspace{6pt}
}

% Solutions block header — emitted once, before first \solution
\newcommand{\solutionsheader}{%
  \newpage
  \thispagestyle{solutions}%
  \begin{center}
    \large\textbf{\textit{\OlympString{solutionsheader}}}%
  \end{center}%
  \vspace{6pt}
}
\newcommand{\answersheetsheader}{%
  \newpage
  \pagestyle{answersheets}%
  \begin{center}
    {\large\textbf{\OlympString{answersheetsheader}}}%

    \textit{\OlympString{answersheetheadersubtitle}}
  \end{center}%
  \vspace{6pt}%
}

\newcommand{\markingheader}
{%
  \newpage
  \pagestyle{marking}
}

% ===============================================================
% ANSWER SHEETS - CONTINUATION FROM OLYMPIAD-LAYOUT.STY
% ===============================================================

% Must require using \problem{...} first
\NewDocumentEnvironment{answerbox}{ m o }{%
  \stepcounter{tasknum}%
  \begin{framed}\noindent
  \begin{minipage}[t][#1][t]{\linewidth}
  \noindent\textbf{\OlympCurrentPrefix.\arabic{tasknum}}%
  \IfValueT{#2}{\ifOlympShowPoints \textbf{(#2~\OlympString{points_answersheet})}\fi}%
  \par\bigskip
}{%
  \end{minipage}\end{framed}
}

\NewDocumentEnvironment{answerboxpart}{ m o }{%
  % #1 = height, #2 = optional points
  \setcounter{tasknum}{0}%
  \begin{framed}\noindent
  \begin{minipage}[t][#1][t]{\linewidth}
  \noindent\textbf{\OlympCurrentPrefix}%
  \IfValueT{#2}{\ifOlympShowPoints \textbf{(#2~\OlympString{points_answersheet})}\fi}%
  \par\bigskip
}{%
  \end{minipage}\end{framed}
}

% ...cont = Continuation of the answerbox if there's a pagebreak mid-answerbox
\NewDocumentEnvironment{answerboxcont}{ m }{%
  \begin{framed}\noindent\begin{minipage}[t][#1][t]{\linewidth}
  \noindent\textbf{\OlympCurrentPrefix.\arabic{tasknum}~\OlympString{continued}}%
  \par\bigskip
}{\end{minipage}\end{framed}}

\NewDocumentEnvironment{answerboxpartcont}{ m }{%
  \begin{framed}\noindent\begin{minipage}[t][#1][t]{\linewidth}
  \noindent\textbf{\OlympCurrentPrefix~\OlympString{continued}}%
  \par\bigskip
}{\end{minipage}\end{framed}}

